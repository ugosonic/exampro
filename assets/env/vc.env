# Copy values from your secure environment. Do not commit secrets.
# This file can be replaced at build time (CI/CD) with environment-specific values.
# Keep empty to run in local/offline mode (mock + local DB only).
# Set this per environment (CI/CD or --dart-define=API_BASE_URL=...).
# Android emulator local backend example: http://10.0.2.2:8000
# Web/desktop local backend example: http://localhost:8000
# Production example: https://api.example.com
API_BASE_URL=
ENVIRONMENT=development
ANALYTICS_ENABLED=false
FEATURE_LEADERBOARD=false
JWT_AUDIENCE=exampro-mobile
JWT_ISSUER=exampro-auth
AUTH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
AUTH_ENCRYPTION_IV=abcdef9876543210

# External Postgres connection (Neon)
# Do not commit secrets in real projects. This value can be overridden per-env in CI/CD.
DATABASE_URL=
# Email service
EMAIL_API_URL=
EMAIL_API_KEY=

# Stripe (Do not ship real secrets in app; use backend in production)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CHECKOUT_URL_GBP=
STRIPE_CHECKOUT_URL_USD=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
