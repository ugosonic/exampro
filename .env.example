# Copy to .env in the repo root before running docker-compose
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SYNC_ADMIN_TOKEN=change-me-strong-token
# Preferred: mount service-account JSON into container and reference this path.
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-admin.json
# Optional alternative to file path above:
FCM_SERVICE_ACCOUNT_JSON=

# API host bind (avoid port clashes with other sites)
API_BIND_ADDR=127.0.0.1
API_BIND_PORT=18000

# Admin role emails (comma-separated)
ADMIN_EMAILS=

# SMTP for /admin/send-email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

